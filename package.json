{
  "name": "carecompass",
  "version": "0.1.0",
  "description": "Rule-based tool that turns hospital discharge summaries into a plain-language daily checklist. No LLM, no network calls.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "health-tech",
    "patient-education",
    "biomedical-engineering",
    "rule-based",
    "accessibility",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DhruvPatil-stack/Care_Compass.git"
  },
  "bugs": {
    "url": "https://github.com/DhruvPatil-stack/Care_Compass/issues"
  },
  "homepage": "https://github.com/DhruvPatil-stack/Care_Compass#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx --tsconfig tsconfig.eval.json scripts/eval.ts"
  },
  "dependencies": {
    "lucide-react": "^0.523.0",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "jsdom": "^26",
    "postcss": "^8",
    "tailwindcss": "^3",
    "autoprefixer": "^10",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
}
